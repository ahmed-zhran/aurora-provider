{
  "name": "aurora-provider",
  "version": "2.0.0",
  "description": "Local OpenAI-compatible LLM router with intelligent multi-provider fallback chains — one endpoint, unlimited free LLMs, zero rate limits",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "aurora-provider": "src/server.js"
  },
  "scripts": {
    "start": "bun src/server.js",
    "dev": "bun --watch src/server.js"
  },
  "license": "MIT",
  "author": "Ahmed Zhran",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed-zhran/aurora-provider.git"
  },
  "homepage": "https://github.com/ahmed-zhran/aurora-provider",
  "bugs": {
    "url": "https://github.com/ahmed-zhran/aurora-provider/issues"
  },
  "keywords": [
    "llm",
    "openai",
    "proxy",
    "router",
    "free-api",
    "ai",
    "fallback",
    "rate-limit",
    "openai-compatible",
    "self-hosted",
    "llm-router",
    "api-gateway",
    "groq",
    "cloudflare-ai",
    "openrouter"
  ],
  "dependencies": {
    "hono": "^4.12.23",
    "https-proxy-agent": "^9.0.0",
    "marked": "^18.0.4",
    "marked-gfm-heading-id": "^4.1.4",
    "node-fetch": "^3.3.2",
